{
    "name": "@ohos/hidumper_lite",
    "description": "System information dump service for liteos-a, liteos-m and linux kernel.",
    "optional": "false",
    "version": "4.0.2",
    "license": "Apache License 2.0",
    "publishAs": "code-segment",
    "homePage": "https://gitee.com/openharmony",
    "repository": "https://gitee.com/openharmony/hiviewdfx_hidumper_lite",
    "supplier": "Organization: OpenHarmony",
    "segment": {
        "destPath": "base/hiviewdfx/hidumper_lite"
    },
    "dirs": {},
    "scripts": {},
    "component": {
        "name": "hidumper_lite",
        "subsystem": "hiviewdfx",
        "adapted_system_type": [
            "mini",
            "small"
        ],
        "rom": "264KB",
        "ram": "~2MB",
        "deps": {
            "components": [
                "bounds_checking_function",
                "hilog_lite",
                "liteos_m",
                "utils_lite"
            ],
            "third_party": []
        },
        "features": [
            "hidumper_lite_disable_test"
        ],
        "build": {
            "sub_component": [
                "//base/hiviewdfx/hidumper_lite:hidumper",
                "//base/hiviewdfx/hidumper_lite/small/test:hidumper_lite_test"
            ],
            "test": [
                "//base/hiviewdfx/hidumper_lite/small/test:hidumper_lite_test"
            ]
        }
    }
}
