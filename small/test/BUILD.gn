import("//build/lite/config/test.gni")

declare_args() {
  hidumper_lite_disable_test = false
}

group("hidumper_lite_test") {
  if (ohos_build_type == "debug" && ohos_kernel_type == "linux" &&
      !hidumper_lite_disable_test) {
    deps = [ ":lite_hidumper_unittest" ]
  }
}

if (ohos_build_type == "debug" && ohos_kernel_type == "linux" &&
    !hidumper_lite_disable_test) {
  unittest("lite_hidumper_unittest") {
    output_extension = "bin"
    output_dir = "$root_out_dir/test/unittest/hidumper_lite"
    sources = [ "unittest/lite_hidumper_test.cpp" ]


    include_dirs = [
      "unittest",
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native",
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native/include",
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native/manager",
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native/task",
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native/utils",
      "//base/hiviewdfx/hidumper_lite/small/services/native/include",
      "//base/hiviewdfx/hidumper_lite/small/interfaces/native/innerkits/include",
      "//base/hiviewdfx/hidumper_lite/small/utils/native/include",
      "//base/hiviewdfx/hilog_lite/interfaces/native/kits",
    ]

    deps = [
      "//base/hiviewdfx/hidumper_lite/small/frameworks/native:dump_main",
      "//base/hiviewdfx/hidumper_lite/small/services:hidumperservice_source",
      "//base/hiviewdfx/hidumper_lite/small/utils:utils",
      "//base/hiviewdfx/hilog_lite/frameworks/featured:hilog_shared",
      "//third_party/bounds_checking_function:libsec_shared",
    ]
  }
}
